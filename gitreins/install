#!/usr/bin/env bash
# GitReins Install — One-command activation for SpecLang
# Adapted from gitreins-poc for SpecLang (TypeScript/npm project)
# Run from repo root: ./gitreins/install

set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOOKS_DIR="$REPO_ROOT/.git/hooks"
GITREINS_DIR="$REPO_ROOT/gitreins"

echo "GitReins Install for SpecLang"
echo "============================="
echo "Repo: $REPO_ROOT"
echo ""

# Create .gitreins config dir if needed
mkdir -p "$REPO_ROOT/.gitreins"

# Create default config if missing
if [ ! -f "$REPO_ROOT/.gitreins/config.yaml" ]; then
    cat > "$REPO_ROOT/.gitreins/config.yaml" << 'EOF'
# GitReins Configuration — SpecLang edition
guards:
  secrets: true
  lint: true
  tests: true
  test_command: "npm test"
  assemble: true
  assemble_command: "npm run assemble"
  verify_self_host: true
  verify_command: "npm run verify:self-host"

evaluator:
  max_iterations: 15
EOF
    echo "✓ Created .gitreins/config.yaml"
else
    echo "  .gitreins/config.yaml already exists — skipping"
fi

# Install pre-commit hook
if [ -d "$HOOKS_DIR" ]; then
    cat > "$HOOKS_DIR/pre-commit" << 'HOOKEOF'
#!/usr/bin/env bash
# GitReins pre-commit hook for SpecLang
# Runs Tier 1 guards before every commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Guard 1: Secrets scan (built into Hermes)
echo "  [Guard] Secrets scan..."

# Guard 2: Assemble — ensure spec outputs match
echo "  [Guard] npm run assemble..."
if ! npm run assemble 2>/dev/null; then
    echo "COMMIT BLOCKED: Assembly failed"
    exit 1
fi

# Guard 3: Build
echo "  [Guard] npm run build..."
if ! npm run build 2>/dev/null; then
    echo "COMMIT BLOCKED: Build failed"
    exit 1
fi

# Guard 4: Self-host verification
echo "  [Guard] npm run verify:self-host..."
if ! npm run verify:self-host 2>/dev/null; then
    echo "COMMIT BLOCKED: Self-host verification failed"
    exit 1
fi

# Guard 5: Tests
echo "  [Guard] npm test..."
if ! npm test 2>&1 | tail -5; then
    echo "COMMIT BLOCKED: Tests failed"
    exit 1
fi

echo ""
echo "All Tier 1 guards: PASS"
exit 0
HOOKEOF
    chmod +x "$HOOKS_DIR/pre-commit"
    echo "✓ Installed .git/hooks/pre-commit"
else
    echo "✗ Not a git repository — skipping hooks"
fi

echo ""
echo "GitReins installed for SpecLang. Guards run on every commit:"
echo "  1. ═══ Assemble specs → .speclang/assembled/"
echo "  2. ═══ Build (tsc)"
echo "  3. ═══ Verify self-hosting"
echo "  4. ═══ Run all tests"
echo ""
echo "New SpecLang specs available in specs/gitreins/"
echo "GitReins Python source at gitreins-poc/ (separate project)"
echo ""
