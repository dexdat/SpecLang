{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/dashboard/**/*",
    "src/ui-dashboard/**/*",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/codegen.ts",
    "src/ralph-loop.ts", 
    "src/speclang-mcp.ts",
    "src/validation-system.ts",
    "src/validation.ts",
    "src/ralph_loop.py",
    "src/db/speclang_db.py",
    "src/parser/speclang_parser.py"
  ]
}
