{
  "Speclang Header": {
    "prefix": "speclang-header",
    "body": [
      "# speclang-header lines:${1:12}",
      "id: ${2:@specs/example}",
      "version: ${3:1.0.0}",
      "layer: ${4:5}",
      "project_level: ${5:Alpha}",
      "agent_support: ${6:agent_assonomous}",
      "tags: [${7:example}]",
      "short: ${8:Brief description}",
      "---",
      "",
      "${0}"
    ],
    "description": "Insert a Speclang spec header"
  },
  "Spec Block": {
    "prefix": "block",
    "body": [
      "### @block:${1:block-name} @kind:${2:type}",
      "${0}"
    ],
    "description": "Insert a Speclang spec block"
  },
  "Spec Reference": {
    "prefix": "ref",
    "body": [
      "@ref:${1:specs/path}#${2:block-name}"
    ],
    "description": "Insert a Speclang reference"
  }
}
