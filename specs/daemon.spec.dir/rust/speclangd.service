[Unit]
Description=SpecLang Reactive Cascade Daemon
After=network.target
Documentation=https://speclang.dev/docs/daemon

[Service]
Type=simple
ExecStart=/usr/local/bin/speclangd
Restart=on-failure
RestartSec=3
User=speclang
Group=speclang
WorkingDirectory=/var/lib/speclang
StateDirectory=speclang
RuntimeDirectory=speclang
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
