{
  "name": "speclang",
  "version": "0.1.0",
  "description": "SpecLang turns your AI coding assistant into a self-correcting system where every change propagates until your code is perfect.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speclang": "./bin/speclang"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node bin/speclang start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cascade": "node bin/speclang cascade",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dexdat/SpecLang.git"
  },
  "keywords": [
    "ai",
    "code-generation",
    "specifications",
    "agents",
    "automation",
    "developer-tools",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dexdat/SpecLang/issues"
  },
  "homepage": "https://github.com/dexdat/SpecLang#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.6",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
