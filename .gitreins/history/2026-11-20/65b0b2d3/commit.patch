 import { writeDaemonPromMetrics } from '../../specs/daemon.spec.dir/src/daemon-prom';
 
-const { execute } = vi.hoisted(() => ({ execute: vi.fn() }));
-vi.mock('../../specs/pipeline.spec.dir/src/executor.js', () => ({
+const { execute, executorHref } = vi.hoisted(() => ({
+  execute: vi.fn(),
