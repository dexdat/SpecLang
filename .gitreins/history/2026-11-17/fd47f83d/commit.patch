+        const SPECLANG_SHIM = `#!/usr/bin/env node
+/**
+ * SpecLang CLI shim - generated by "speclang new".
+ *
+ * This project does not install SpecLang from the npm registry: the published
+ * "speclang" package is an unrelated project and this CLI is not published
+ * there. Instead of a machine-specific "file:" dependency, this script
+ * delegates to a SpecLang CLI resolved at runtime, first match wins:
+ *
+ *   1. $SPECLANG_CLI                  explicit override (always wins)
+ *   2. node_modules/speclang          a real install of this CLI, e.g.
+ *      npm install --save-dev https://github.com/dexdat/SpecLang
+ *   3. node_modules/.bin/speclang     a linked or globally installed CLI
+ *   4. the CLI that generated this project (the fallback recorded below)
+ *
+ * Usage:
+ *   node scripts/speclang.cjs <command> [args...]
+ *   npm run validate | npm run generate | npm run start
+ */
+'use strict';
+
+const { spawnSync } = require('node:child_process');
+const { existsSync, realpathSync } = require('node:fs');
+const { createRequire } = require('node:module');
+const path = require('node:path');
+
+// The CLI that scaffolded this project. Machine-specific on purpose: it is the
+// last-resort fallback and it is overridable with $SPECLANG_CLI.
+const GENERATOR_CLI = ${JSON.stringify(generatorCli)};
+
+const SELF = (() => {
+  try {
+    return realpathSync(__filename);
+  } catch (_) {
+    return __filename;
+  }
+})();
+
+function installedCli() {
+  try {
+    const fromProject = createRequire(path.join(__dirname, '..', 'package.json'));
+    const pkgPath = fromProject.resolve('speclang/package.json');
+    const pkg = fromProject(pkgPath);
+    const bin = typeof pkg.bin === 'string' ? pkg.bin : pkg.bin && pkg.bin.speclang;
+    if (bin) return path.resolve(path.dirname(pkgPath), bin);
+  } catch (_) {
+    // not installed in this project
+  }
+  const linked = path.join(__dirname, '..', 'node_modules', '.bin', 'speclang');
+  return existsSync(linked) ? linked : null;
+}
+
+function resolveCli() {
+  const explicit = String(process.env.SPECLANG_CLI || '').trim();
+  if (explicit) {
+    if (!existsSync(explicit)) {
+      console.error('speclang shim: $SPECLANG_CLI points at a path that does not exist:');
+      console.error('  ' + explicit);
+      process.exit(127);
+    }
+    return explicit;
+  }
+  for (const candidate of [installedCli(), GENERATOR_CLI]) {
+    if (!candidate || !existsSync(candidate)) continue;
+    // Never resolve back to this shim (a self-referential node_modules/.bin
+    // link would recurse forever).
+    try {
+      if (realpathSync(candidate) === SELF) continue;
+    } catch (_) {
+      continue;
+    }
+    return candidate;
+  }
+  return null;
+}
+
+const args = process.argv.slice(2);
+const cli = resolveCli();
+
+if (!cli) {
+  console.error('speclang shim: no SpecLang CLI found.');
+  console.error('  The CLI that generated this project is gone:');
+  console.error('    ' + GENERATOR_CLI);
+  console.error('  Point this project at a SpecLang CLI:');
+  console.error('    SPECLANG_CLI=/path/to/SpecLang/bin/speclang npm run validate');
+  console.error('    or: npm install --save-dev https://github.com/dexdat/SpecLang');
+  process.exit(127);
+}
+
+// A source checkout of the CLI needs its TypeScript build before commands like
+// "validate" work. Say so here: the CLI's own advice ("npm run build") would
+// re-enter this project's scripts instead of building the CLI.
+const cliRoot = path.resolve(path.dirname(cli), '..');
+const informational = args.length === 0 || ['--version', '-V', '--help', '-h'].includes(args[0]);
+if (!informational && !existsSync(path.join(cliRoot, 'dist'))) {
+  console.error('speclang shim: the CLI at ' + cli + ' has no dist/ build yet.');
+  console.error('  Build it once in that checkout, or set $SPECLANG_CLI to a built CLI:');
+  console.error('    (cd ' + cliRoot + ' && npm install && npm run build)');
+}
+
+const result = spawnSync(process.execPath, [cli].concat(args), {
+  stdio: 'inherit',
+  cwd: process.cwd(),
+  env: process.env,
+});
+
+if (result.error) {
+  console.error('speclang shim: failed to run ' + cli + ': ' + result.error.message);
+  process.exit(1);
+}
+process.exit(result.status === null ? 1 : result.status);
+`;
+        fs.mkdirSync(path.join(projectPath, 'scripts'), { recursive: true });
+        const shimPath = path.join(projectPath, 'scripts', 'speclang.cjs');
+        fs.writeFileSync(shimPath, SPECLANG_SHIM);
+        fs.chmodSync(shimPath, 0o755);
