+    expect(seriesValue(payload, CONVERGENCE_FAMILY, { outcome: 'not_converged' })).toBe(1);
+    expect(seriesValue(payload, STAGE_DURATION_FAMILY, { stage: 'probe' })).not.toBeNaN();
