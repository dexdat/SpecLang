 // Version from package.json
 const packageJson = require('../package.json');
 
+// DF-SPECLANG-6: `.speclang/daemon.pid` is shared state between the serving
+// process and this CLI. The daemon's own SIGTERM handler removes the file and
+// `speclang stop` removes it too, so whichever side is second must treat
+// "already gone" as a benign no-op instead of crashing with an uncaught ENOENT.
+// An unreadable/empty/garbage file is stale state, never a process to signal.
+function readDaemonPid(pidFile) {
+  let raw;
+  try {
+    raw = fs.readFileSync(pidFile, 'utf-8');
+  } catch (err) {
+    if (err.code === 'ENOENT') return null; // raced with another stop/shutdown
+    throw err;
+  }
+  const pid = parseInt(raw.trim(), 10);
+  return Number.isInteger(pid) && pid > 0 ? pid : null;
+}
+
+function removeDaemonPidFile(pidFile) {
+  try {
+    fs.unlinkSync(pidFile);
+  } catch (err) {
+    // Idempotent shutdown: a second unlink of the same pid file is not an error.
+    if (err.code !== 'ENOENT') throw err;
+  }
+}
+
 const program = new Command();
 
